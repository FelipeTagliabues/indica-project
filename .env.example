# Copie para .env e substitua todos os marcadores pelos dados do PostgreSQL autorizado.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Porta local da API. Não implica que o banco esteja disponível.
PORT=3333
NODE_ENV=development

# Autenticação. Gere um segredo aleatório com no mínimo 32 caracteres; não reutilize este exemplo.
APP_BASE_URL="http://localhost:5173"
AUTH_CSRF_SECRET="SUBSTITUA_POR_UM_SEGREDO_ALEATORIO_DE_32_CARACTERES"
AUTH_COOKIE_NAME="indica_session"

# Provedor transacional SMTP. Valores ilustrativos, sem credenciais reais.
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="usuario-ilustrativo"
SMTP_PASSWORD="senha-ilustrativa"
EMAIL_FROM="no-reply@example.com"

# Em desenvolvimento local, deixe vazio para usar o proxy do Vite para localhost:3333.
VITE_API_URL=""
VITE_API_PROXY_TARGET="http://localhost:3333"

# Proteções explícitas para scripts que acessam o banco de desenvolvimento exclusivo.
INDICA_DATABASE_IS_EXCLUSIVE=false
INDICA_ALLOW_EXCLUSIVE_DB_TESTS=false
